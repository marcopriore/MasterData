# Modelo de variáveis do PRO-MAT. Copie para .env.local (desenvolvimento)
# ou .env.production.local (valores de produção) e preencha. Nunca commite os arquivos preenchidos.
# Na Vercel, cada variável vai em Settings → Environment Variables, escopo Production.
# Variáveis NEXT_PUBLIC_* entram no build: depois de mudar, faça um novo deploy.

# ── Supabase (Settings → API do projeto) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Endereço público da aplicação, sem barra no final ────────────────────────
# Usado nos links dos e-mails e das solicitações criadas por API.
NEXT_PUBLIC_APP_URL=https://app.seudominio.com.br

# ── Segredos de integração com o ERP ─────────────────────────────────────────
# 32 bytes em base64 (npm run secrets). Precisa ser a MESMA chave do ambiente
# onde os segredos das integrações foram salvos; se mudar, eles têm de ser digitados de novo.
INTEGRATION_SECRET_KEY=

# ── E-mail (Resend) — opcional; sem a chave o sino continua e o e-mail não sai ─
RESEND_API_KEY=
# Só o endereço; o nome "PRO-MAT" é colocado pelo sistema. O domínio precisa estar verificado no Resend.
RESEND_FROM_EMAIL=noreply@seudominio.com.br

# ── Suporte AxisDesk — opcional ──────────────────────────────────────────────
AXISDESK_API_KEY=
# Mesmo valor configurado no AxisDesk para o webhook (npm run secrets gera um).
AXISDESK_WEBHOOK_SECRET=
# AXISDESK_BASE_URL=https://suporte.axisstrategy.com.br
